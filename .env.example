# ==========================================
# ctrl-cli Configuration
# ==========================================

# 1. Put your API Key here (Required):
AI_API_KEY=your_api_key_here

# 2. Base URL for your OpenAI-compatible API (Optional, default is OpenAI):
# Examples:
# - OpenAI:     https://api.openai.com/v1
# - DeepSeek:   https://api.deepseek.com/v1
# - Groq:       https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# 3. Model Name (Optional, default is gpt-4o-mini):
# Examples:
# - OpenAI:     gpt-4o-mini, gpt-4o
# - DeepSeek:   deepseek-chat
# - Groq:       llama-3.3-70b-versatile, qwen-2.5-coder-32b
# - OpenRouter: anthropic/claude-3.5-sonnet, deepseek/deepseek-r1
AI_MODEL=gpt-4o-mini
